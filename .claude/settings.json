{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/health-banner.sh",
            "timeout": 7
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.stan)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-stan-syntax.sh",
            "timeout": 10,
            "statusMessage": "Checking Stan syntax..."
          },
          {
            "type": "command",
            "if": "Write(**/*.stan)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-stan-syntax.sh",
            "timeout": 10,
            "statusMessage": "Checking Stan syntax..."
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/_legacy/**/CLAUDE.md"
  ],
  "permissions": {
    "ask": [
      "Bash(*auto_place*)",
      "Bash(*install-autoplace*)",
      "Bash(*is.metill.sports.autoplace*)"
    ]
  }
}
