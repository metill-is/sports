{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sports/config/leagues.yml",
  "type": "object",
  "patternProperties": {
    "^[a-z]+_[a-z]+(_[a-z]+)*$": {
      "type": "object",
      "required": ["sport", "country", "sexes", "active", "data_source", "stan_model"],
      "properties": {
        "sport":    { "type": "string", "enum": ["football", "basketball", "handball"] },
        "country":  { "type": "string", "minLength": 2 },
        "sexes":    { "type": "array", "items": { "type": "string", "enum": ["male", "female"] }, "minItems": 1 },
        "active":   { "type": "boolean" },
        "data_source": {
          "type": "object",
          "required": ["results", "schedule"],
          "properties": {
            "results":  { "type": "string" },
            "schedule": { "type": "string" },
            "odds":     { "type": ["string", "null"] }
          }
        },
        "lengjan": {
          "type": "object",
          "properties": {
            "competitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "sex"],
                "properties": {
                  "id":   { "type": "string" },
                  "name": { "type": "string" },
                  "sex":  { "type": "string", "enum": ["male", "female"] }
                }
              }
            },
            "team_names": {
              "type": "object",
              "required": ["male", "female"],
              "additionalProperties": false,
              "description": "Per-sex canonical -> Lengjan rendering map. A value is either one rendering (string) or a list of acceptable renderings (array) when Lengjan renders the same team under more than one byte-distinct string; the first array element is the primary the placer types.",
              "properties": {
                "male":   { "type": "object", "additionalProperties": { "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 } ] } },
                "female": { "type": "object", "additionalProperties": { "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 } ] } }
              }
            }
          }
        },
        "stan_model": { "type": "string" },
        "training_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["divisions", "lookback_days"],
          "description": "Restrict Stan training set to matches where both teams have competed in `divisions` within the last `lookback_days` from end_date. Cuts the funnel-shaped posterior from amateur teams with thin data + extreme cup blowouts.",
          "properties": {
            "divisions": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "lookback_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "publish_divisions": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-sex publish surface. Mirrored by the metill-platform consumer's DIVISIONS dict. Each entry's slug is both the consumer URL segment and the dir suffix under data/publish/{sport}/{country}/{sex_folder}-{slug}/.",
          "properties": {
            "male":   { "$ref": "#/definitions/publishDivisionList" },
            "female": { "$ref": "#/definitions/publishDivisionList" }
          }
        },
        "betting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kelly_frac", "ev_threshold", "markets", "scoring", "min_bet"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Publish-only switch. When false, decide/placer/odds-ingest refuse this league (spec 2026-09-02 §3, decision D2). Absent means enabled -- football carries no key."
            },
            "kelly_frac": {
              "oneOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "male":   { "type": "number", "minimum": 0, "maximum": 1 },
                    "female": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              ]
            },
            "max_match_stake": { "type": "number", "minimum": 0, "maximum": 1 },
            "ev_threshold": { "type": "number" },
            "markets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "moneyline": { "type": "boolean" },
                "spread":    { "type": "boolean" },
                "total":     { "type": "boolean" }
              }
            },
            "scoring": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "has_ties":      { "type": "boolean" },
                "tie_threshold": { "type": "number" }
              }
            },
            "min_bet":       { "type": "number", "minimum": 0 },
            "max_age_hours": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "publishDivisionList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "slug", "label_is", "is_cup"],
        "additionalProperties": false,
        "properties": {
          "code":     { "type": "string", "minLength": 1 },
          "slug":     { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "label_is": { "type": "string", "minLength": 1 },
          "is_cup":   { "type": "boolean" },
          "code_badge": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,3}$",
            "description": "Short badge used as next_games.division_code, which the publish schemas pattern as ^[A-Z][A-Z0-9_]*$. Needed wherever `code` is not itself a legal badge -- basketball's 1D starts with a digit. Defaults to `code` when absent."
          },
          "expected_meetings": {
            "type": "integer",
            "minimum": 1,
            "description": "How many times each pair meets in the regular season. 2 = double round robin; Icelandic women's handball plays 3. Omit where the format is irregular (basketball female 1D) and n_rounds is derived from the schedule instead."
          },
          "relegation_slots": {
            "type": "integer",
            "minimum": 0,
            "description": "Teams relegated from this division. Omit where there is none."
          },
          "qualify": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slots", "label_is"],
            "properties": {
              "slots": { "type": "integer", "minimum": 1 },
              "label_is": { "type": "string", "minLength": 1 }
            },
            "description": "Post-season qualification cut, where one exists and is a simple top-N. Deliberately ABSENT for basketball and handball: their four cells have four different structures and women's Bonusdeild carries all ten teams through, so no single integer expresses it (Plan B ID-B15)."
          },
          "split": {
            "type": "object",
            "description": "Split-season format (efri/neðri hluti): after the regular phase the table splits into an upper group of `upper` and a lower group of `lower` teams, each playing a single round-robin with full carry-over and a group-locked final table. Absent = flat league.",
            "required": ["upper", "lower"],
            "additionalProperties": false,
            "properties": {
              "upper": { "type": "integer", "minimum": 2 },
              "lower": { "type": "integer", "minimum": 2 }
            }
          }
        }
      }
    }
  }
}
