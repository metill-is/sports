{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metill-is/sports/config/publish-schemas/team_strengths.schema.json",
  "title": "data/publish/.../team_strengths.json",
  "description": "9-cell strength grid per team (component x location). Optional `preseason` carries the latest archived fit strictly before the cell's first played kickoff, used by the platform's forest-plot baseline row.",
  "type": "object",
  "required": [
    "generated_at",
    "records"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "team",
          "component",
          "location",
          "median",
          "coverage",
          "lower",
          "upper"
        ],
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "enum": [
              "offence",
              "defence",
              "total"
            ]
          },
          "location": {
            "type": "string",
            "enum": [
              "home",
              "away",
              "avg"
            ]
          },
          "median": {
            "type": "number"
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lower": {
            "type": "number"
          },
          "upper": {
            "type": "number"
          },
          "preseason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "median",
                  "lower",
                  "upper"
                ],
                "properties": {
                  "median": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "lower": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "upper": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
