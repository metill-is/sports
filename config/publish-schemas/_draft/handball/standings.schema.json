{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metill-is/sports/config/publish-schemas/standings.schema.json",
  "title": "data/publish/.../standings.json",
  "description": "Current league table with cumulative xPts/xG and per-team form/trend arrays. Empty {rows: []} for cup cells.",
  "type": "object",
  "required": [
    "generated_at",
    "season",
    "as_of",
    "rows"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "season": {
      "type": "integer",
      "minimum": 2000
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "team",
          "short",
          "played",
          "wins",
          "draws",
          "losses",
          "goals_for",
          "goals_against",
          "goal_diff",
          "points",
          "xg_for",
          "xg_against",
          "xpts",
          "n_predicted_matches",
          "n_played_matches",
          "rank",
          "form",
          "xg_trend",
          "xg_against_trend",
          "goals_trend",
          "goals_against_trend"
        ],
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string"
          },
          "played": {
            "type": "integer",
            "minimum": 0
          },
          "wins": {
            "type": "integer",
            "minimum": 0
          },
          "draws": {
            "type": "integer",
            "minimum": 0
          },
          "losses": {
            "type": "integer",
            "minimum": 0
          },
          "goals_for": {
            "type": "integer",
            "minimum": 0
          },
          "goals_against": {
            "type": "integer",
            "minimum": 0
          },
          "goal_diff": {
            "type": "integer"
          },
          "points": {
            "type": "integer",
            "minimum": 0
          },
          "xg_for": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "xg_against": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "xpts": {
            "type": [
              "number",
              "null"
            ]
          },
          "n_predicted_matches": {
            "type": "integer",
            "minimum": 0
          },
          "n_played_matches": {
            "type": "integer",
            "minimum": 0
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "form": {
            "type": [
              "array",
              "null"
            ]
          },
          "xg_trend": {
            "type": [
              "array",
              "null"
            ]
          },
          "xg_against_trend": {
            "type": [
              "array",
              "null"
            ]
          },
          "goals_trend": {
            "type": [
              "array",
              "number",
              "null"
            ]
          },
          "goals_against_trend": {
            "type": [
              "array",
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
