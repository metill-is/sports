{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metill-is/sports/config/publish-schemas/home_advantage.schema.json",
  "title": "data/publish/.../home_advantage.json",
  "description": "Per-team home-advantage posterior summary by component (e.g. log-offence, log-defence). Currently published but not surfaced on the platform.",
  "type": "object",
  "required": [
    "generated_at",
    "records"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "team",
          "component",
          "median",
          "coverage",
          "lower",
          "upper"
        ],
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "median": {
            "type": "number"
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lower": {
            "type": "number"
          },
          "upper": {
            "type": "number"
          }
        }
      }
    }
  }
}
