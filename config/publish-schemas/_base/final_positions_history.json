{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metill-is/sports/config/publish-schemas/final_positions_history.schema.json",
  "title": "data/publish/.../final_positions_history.json",
  "description": "Per-round per-team placement-probability snapshots, deduplicated on (as_of, team, placement) so the frontend can offer a round filter on the placements heatmap.",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "as_of",
          "generated_at",
          "round",
          "season",
          "team",
          "placement",
          "probability"
        ],
        "properties": {
          "as_of": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "generated_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "season": {
            "type": "integer",
            "minimum": 2000
          },
          "team": {
            "type": "string",
            "minLength": 1
          },
          "placement": {
            "type": "integer",
            "minimum": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
