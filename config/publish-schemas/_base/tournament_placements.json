{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metill-is/sports/config/publish-schemas/tournament_placements.schema.json",
  "title": "data/publish/.../tournament_placements.json",
  "description": "Cup-only: per-team P(reach round X) cumulative across {R16, QF, SF, Final, Champion} from the R/simulate-cup-bracket.R forward simulator. Always paired with meta.json::is_cup=true.",
  "type": "object",
  "required": [
    "generated_at",
    "season",
    "n_teams",
    "records",
    "summary"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "season": {
      "type": "integer",
      "minimum": 2000
    },
    "n_teams": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "team",
          "round_name",
          "probability"
        ],
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1
          },
          "round_name": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "team",
          "p_champion"
        ],
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1
          },
          "p_champion": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
