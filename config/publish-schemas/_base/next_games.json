{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metill-is/sports/config/publish-schemas/next_games.schema.json",
  "title": "data/publish/.../next_games.json",
  "description": "Upcoming matches with model predictions: per-match mean goals, outcome probabilities, and goal-diff distribution.",
  "type": "object",
  "required": [
    "generated_at",
    "matches"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "venue",
          "division",
          "division_code",
          "home",
          "away",
          "mean_home_goals",
          "mean_away_goals",
          "mean_goal_diff",
          "p_home_win",
          "p_draw",
          "p_away_win",
          "goal_diff_distribution"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "division": {
            "type": "string"
          },
          "division_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "home": {
            "type": "string",
            "minLength": 1
          },
          "away": {
            "type": "string",
            "minLength": 1
          },
          "mean_home_goals": {
            "type": "number"
          },
          "mean_away_goals": {
            "type": "number"
          },
          "mean_goal_diff": {
            "type": "number"
          },
          "p_home_win": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p_draw": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p_away_win": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "goal_diff_distribution": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "diff",
                "p"
              ],
              "properties": {
                "diff": {
                  "type": "integer"
                },
                "p": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
