{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metill-is/sports/config/publish-schemas/final_positions.schema.json",
  "title": "data/publish/.../final_positions.json",
  "description": "Refused outright, not merely optional. Measured on season 2026 the four basketball cells qualify 8 of 12, 8 of 12, 10 of 10 and 4 of 11 teams for the post-season -- four cells, four structures, one of which takes every team through -- and the league table decides the deildarmeistari while the Islandsmeistari comes out of an urslitakeppni this model does not simulate. A p_top_six or p_winner here would be a top-six number wearing a playoff label (design D3), so the contract rejects it rather than tolerating it.",
  "type": "object",
  "required": [
    "generated_at",
    "season",
    "n_teams",
    "records",
    "summary",
    "basis"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "season": {
      "type": "integer",
      "minimum": 2000
    },
    "n_teams": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "team",
          "placement",
          "probability"
        ],
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1
          },
          "placement": {
            "type": "integer",
            "minimum": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "team",
          "p_top_of_table",
          "p_relegation"
        ],
        "properties": {
          "team": {
            "type": "string",
            "minLength": 1
          },
          "p_top_six": false,
          "p_winner": false,
          "p_relegation": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p_top_of_table": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "P(placement == 1) in the regular-season table."
          },
          "p_qualify": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Probability of making the division's configured qualification cut. Emitted only where meta.qualify is non-null."
          }
        }
      }
    },
    "basis": {
      "enum": [
        "regular_season_table"
      ],
      "description": "Narrowed: placements here are the REGULAR-season table. The post-season is unmodelled."
    }
  }
}
