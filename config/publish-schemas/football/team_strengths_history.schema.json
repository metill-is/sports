{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/metill-is/sports/config/publish-schemas/team_strengths_history.schema.json",
  "title": "data/publish/.../team_strengths_history.json",
  "description": "Per-round per-team strength snapshots accumulated across fits. Frontend slices by `round` for the time-evolution forest plot.",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fit_date", "generated_at", "round", "season", "team",
          "component", "location", "coverage", "median", "lower", "upper"
        ],
        "properties": {
          "fit_date":     { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
          "round":        { "type": "integer", "minimum": 0 },
          "season":       { "type": "integer", "minimum": 2000 },
          "team":         { "type": "string", "minLength": 1 },
          "component":    { "type": "string", "enum": ["offence", "defence", "total"] },
          "location":     { "type": "string", "enum": ["home", "away", "avg"] },
          "coverage":     { "type": "number", "minimum": 0, "maximum": 1 },
          "median":       { "type": "number" },
          "lower":        { "type": "number" },
          "upper":        { "type": "number" }
        }
      }
    }
  }
}
